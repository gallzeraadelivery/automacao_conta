# syntax=docker/dockerfile:1
#
# Worker + Electron mobile shell (Android/iPhone) + Chromium fallback.
FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY apps/mobile-shell ./apps/mobile-shell
RUN pnpm install --frozen-lockfile --prod

FROM base AS runtime
ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
ENV AUTOMATION_HEADLESS=false
ENV PLAYWRIGHT_BROWSER_CHANNEL=chromium
ENV AUTOMATION_BROWSER_ENGINE=electron
ENV AUTOMATION_FINGERPRINT_OS=auto
ENV DISPLAY=:99

COPY --from=deps /app ./

# xvfb + VNC (ver a tela headed no Mac via http://localhost:6080) + deps browser
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    procps \
    xauth \
    fonts-liberation \
    fonts-noto-color-emoji \
    ca-certificates \
    wget \
    gnupg \
    libnss3 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm1 \
    libasound2 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libdrm2 \
    libxkbcommon0 \
    libcups2 \
    libpango-1.0-0 \
    libcairo2 \
  && rm -rf /var/lib/apt/lists/*

# Playwright do lockfile via filter worker (+ fallback cli.js). Sem npx --yes.
RUN set -eu; \
  install_chromium() { \
    if pnpm --filter @uber-automation/worker exec playwright install --with-deps chromium; then \
      return 0; \
    fi; \
    PW_CLI=$$(find /app/node_modules -path '*/playwright/cli.js' 2>/dev/null | head -1); \
    if [ -n "$$PW_CLI" ]; then \
      echo "fallback: node $$PW_CLI install --with-deps chromium"; \
      node "$$PW_CLI" install --with-deps chromium; \
      return $$?; \
    fi; \
    echo "playwright cli nao encontrado no node_modules"; \
    return 1; \
  }; \
  i=1; \
  while [ "$$i" -le 3 ]; do \
    echo "==> playwright install chromium (tentativa $$i/3)"; \
    if install_chromium; then \
      break; \
    fi; \
    i=$$((i + 1)); \
    if [ "$$i" -le 3 ]; then sleep 15; fi; \
  done; \
  if ! find "$$PLAYWRIGHT_BROWSERS_PATH" -type f \( -name headless_shell -o -name chrome -o -name chromium \) 2>/dev/null | grep -q .; then \
    echo "ERRO: Chromium do Playwright nao instalado em $$PLAYWRIGHT_BROWSERS_PATH"; \
    ls -la "$$PLAYWRIGHT_BROWSERS_PATH" 2>/dev/null || true; \
    find /app/node_modules -path '*/playwright/cli.js' 2>/dev/null | head -10 || true; \
    exit 1; \
  fi; \
  echo "==> Playwright chromium OK"; \
  pnpm --filter @uber-automation/worker exec playwright install --with-deps chrome \
    || echo "WARN: canal chrome indisponivel nesta arch — runtime usa chromium"

RUN groupadd --system --gid 1001 nodeworker \
  && useradd --system --uid 1001 --gid nodeworker --home-dir /app workeruser \
  && mkdir -p /app/storage/browser-profiles \
  && chown -R workeruser:nodeworker /app

COPY infra/docker/worker-entrypoint.sh /app/worker-entrypoint.sh
RUN chmod +x /app/worker-entrypoint.sh \
  && chown workeruser:nodeworker /app/worker-entrypoint.sh

USER workeruser

CMD ["/app/worker-entrypoint.sh"]
