FROM node:22-slim

RUN corepack enable

WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.json ./
COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile

WORKDIR /app
EXPOSE 3000

CMD ["pnpm", "--filter", "@uber-automation/web", "dev"]
