# syntax=docker/dockerfile:1
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.json ./
COPY packages/license-shared ./packages/license-shared
COPY apps/license-server ./apps/license-server
ENV PNPM_MINIMUM_RELEASE_AGE=0
RUN pnpm install --prod

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=deps /app ./
WORKDIR /app/apps/license-server
ENV LICENSE_DB_PATH=/app/data/licenses.sqlite
RUN mkdir -p /app/data
EXPOSE 8090
# tsx direto — evita corepack/pnpm em runtime (problemas de permissão)
CMD ["node", "../../node_modules/tsx/dist/cli.mjs", "src/index.ts"]
