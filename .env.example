# =============================================================================
# uber-automation - variaveis de ambiente (exemplo)
# Copie para .env e preencha os valores reais. NUNCA versione o .env real.
# =============================================================================

# --- Geral ---
NODE_ENV=development

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=uber_automation
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=uber_automation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://uber_automation:change-me-strong-password@localhost:5432/uber_automation

# --- Redis (filas BullMQ / cache / rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# JWT - gere segredos fortes e distintos, ex: `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Chave mestra para criptografia AES-256-GCM de credenciais (32 bytes em hex = 64 chars)
# Usada apenas pelo fallback local do CredentialVault (SECRETS_PROVIDER=local)
# quando o arquivo SECRETS_KEY_FILE_PATH nao existe. Gere com: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters-32-byte-key

# Rate limiting de login
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Web (apps/web - Next.js) ---
# Usada no BUILD do frontend (embutida no bundle do cliente) - mudar isto
# sem rebuildar a imagem Docker do painel não tem efeito (ver Dockerfile.web).
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000

# Usada pela API (não pelo painel) para montar o link seguro de entrega ao
# motorista na Central de Pendências (Fase 6): `${WEB_PUBLIC_URL}/d/:token`.
# Normalmente é a mesma origem pública que os motoristas acessam.
WEB_PUBLIC_URL=http://localhost:3000

# --- Worker (apps/worker) ---
WORKER_CONCURRENCY=1

# --- CredentialVault (Fase 2) - de onde vem a chave mestra ---
# local (padrao, desenvolvimento): le SECRETS_KEY_FILE_PATH; se o arquivo nao
#   existir, cai de volta para CREDENTIAL_ENCRYPTION_KEY acima.
# aws (recomendado em producao): busca a chave no AWS Secrets Manager.
SECRETS_PROVIDER=local

# Usado quando SECRETS_PROVIDER=local. Nunca commite esse arquivo.
# Gere com: openssl rand -hex 32 > .secrets.key
SECRETS_KEY_FILE_PATH=.secrets.key

# Usado quando SECRETS_PROVIDER=aws. O segredo deve conter os 64 caracteres
# hex da chave (o mesmo formato de CREDENTIAL_ENCRYPTION_KEY).
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_REGION=us-east-1

# --- Perfis de navegador isolados (Fase 2) ---
# Diretorio onde ficam os cookies/localStorage/sessionStorage por motorista
# (storage/browser-profiles/applicant-{id}/...). Nunca versione esse diretorio.
BROWSER_PROFILES_STORAGE_PATH=apps/worker/storage/browser-profiles

# --- E-mail / IMAP (EmailVerificationWorker) ---
# Credenciais individuais de cada motorista sao armazenadas criptografadas no
# banco (via CredentialVault), nao aqui. O host IMAP e escolhido por conta
# conforme email_accounts.provider (gmail, spacemail, outlook, yahoo).
# Spacemail: mail.spacemail.com:993 SSL - IMAP precisa estar habilitado na caixa.
EMAIL_SERVICE_PROVIDER=gmail

# --- Proxies ---
PROXY_TEST_TIMEOUT_MS=10000
PROXY_TEST_URL=https://api.ipify.org?format=json

# --- Mock Uber server (Fase 3 - apps/mock-server) ---
# Ambiente de testes local que simula o fluxo de cadastro da Uber, para
# validar a automacao sem tocar a plataforma real. Nunca use em producao.
MOCK_SERVER_PORT=3001
MOCK_SESSION_SECRET=replace-with-any-random-string-for-local-testing

# --- Automação de navegador (Fase 7 - apps/worker) ---
# "mock" (padrao, seguro): a automacao mira em apps/mock-server (nunca a
# Uber real). So mude para "production" depois de validar manualmente os
# seletores contra o site real com uma conta de teste - ver SECURITY.md.
AUTOMATION_TARGET=mock
# Fora do Docker (pnpm dev:worker local), aponta para o mock-server rodando
# em localhost; dentro do docker-compose isso e sobrescrito para o hostname
# do servico na rede Docker (mock-server:3001) - ver infra/docker/docker-compose.yml.
MOCK_UBER_BASE_URL=http://localhost:3001/mock-uber
# false = headed (janela real). No Docker o worker usa xvfb + false para
# evitar HeadlessChrome. true = headless puro (mais detectável).
AUTOMATION_HEADLESS=true
# Canal Playwright: chrome (Chrome for Testing) ou chromium. No Docker
# compose o worker força chrome; se indisponível, defina chromium.
# PLAYWRIGHT_BROWSER_CHANNEL=chrome
# Pool de fingerprint: auto|linux|linux-arm|mixed (Docker Linux → auto)
# AUTOMATION_FINGERPRINT_OS=auto
# Screenshot automatico quando a automacao pausa ou da erro (nunca em
# sucesso) - ajuda a diagnosticar seletor errado sem precisar de tela.
AUTOMATION_SCREENSHOTS_PATH=storage/automation-screenshots
# Telefone US base no signup (10 dígitos). Tentativas: base, base+1, base+2…
# Ex.: 5613256600 → (561) 325-6600, 6601, 6602…
UBER_PLACEHOLDER_PHONE_BASE=5613256600
