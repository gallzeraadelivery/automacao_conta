{
  "name": "uber-automation",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de automacao assistida para preenchimento administrativo de cadastros de motoristas parceiros",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm -r --filter=./apps/** build",
    "dev:api": "pnpm --filter @uber-automation/api dev",
    "dev:web": "pnpm --filter @uber-automation/web dev",
    "dev:worker": "pnpm --filter @uber-automation/worker dev",
    "db:generate": "pnpm --filter @uber-automation/database db:generate",
    "db:migrate": "pnpm --filter @uber-automation/database db:migrate",
    "db:seed": "pnpm --filter @uber-automation/database db:seed",
    "db:studio": "pnpm --filter @uber-automation/database db:studio",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
